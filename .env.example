# =====================================================================
# ATTITUDE COLLECTIONS — environment variables
# Copy to .env.local for local development, and add the same keys in your
# host's dashboard (e.g. Vercel → Project → Settings → Environment Variables).
#
# PUBLIC  = prefixed NEXT_PUBLIC_, bundled into browser JavaScript. Safe to expose.
# SECRET  = server-only. NEVER prefix with NEXT_PUBLIC_, never commit real values.
# =====================================================================

# --- Site ------------------------------------------------------------------
# PUBLIC. Full public URL of the store, no trailing slash. Used for payment
# callbacks, email links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Supabase (Project Settings → API) -------------------------------------
# PUBLIC. Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# PUBLIC. Publishable key (sb_publishable_…) — or the legacy "anon" key via
# NEXT_PUBLIC_SUPABASE_ANON_KEY. Row Level Security protects all data it can reach.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# SECRET. Secret key (sb_secret_…) — or the legacy "service_role" key via
# SUPABASE_SERVICE_ROLE_KEY. Bypasses RLS; used only in server code for carts,
# order creation, payment finalisation and image uploads.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# --- Paystack (Dashboard → Settings → API Keys & Webhooks) -----------------
# Start with TEST keys (pk_test_ / sk_test_). Switch to live keys only after
# the full checkout → payment → webhook flow has been verified.
# PUBLIC. Not currently required by the redirect checkout, kept for inline/popup use.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your-paystack-public-key
# SECRET. Used server-side to initialise and verify transactions AND to verify
# webhook signatures (Paystack signs webhooks with your secret key — there is
# no separate webhook secret). Set the webhook URL in Paystack to:
#   https://your-domain.com/api/webhooks/paystack
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# --- Email (optional, for order confirmations & contact notifications) ------
# SECRET. Resend API key. Leave blank to disable emails (the store still works;
# customers see confirmations on screen).
RESEND_API_KEY=
# Sender, from a domain verified in Resend, e.g. "Attitude Collections <orders@your-domain.com>"
EMAIL_FROM=

# --- Dj Attitude Mini chat assistant (optional) ------------------------------
# SECRET. Anthropic API key from https://platform.claude.com (Settings → API keys).
# Leave blank and the chat still works in "basic mode" (scripted answers + jokes).
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-opus-5-5
# ASSISTANT_MODEL=

# --- Security ---------------------------------------------------------------
# SECRET. Random string used to hash visitor IPs for rate limiting.
# Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=change-me-to-a-long-random-string

# --- Testing only -------------------------------------------------------------
# Postgres connection for `npm run test:db` (creates and drops throwaway databases).
# Never point this at production.
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
# Overrides the Paystack API base URL for automated tests against a local mock.
# Do NOT set in production.
# PAYSTACK_API_BASE=
